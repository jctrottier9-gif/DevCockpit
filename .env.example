DEVCOCKPIT_APP_NAME=DevCockpit
DEVCOCKPIT_ENVIRONMENT=development
DEVCOCKPIT_DATABASE_URL=sqlite+pysqlite:///./devcockpit.db
DEVCOCKPIT_PROJECTS_CONFIG_PATH=projects.json

# Optional for private repositories, GitHub write operations, or higher API limits.
# Never expose this token to React or the Firefox extension.
# DEVCOCKPIT_GITHUB_TOKEN=github_pat_...

DEVCOCKPIT_GITHUB_TIMEOUT_SECONDS=5

# Set to 0 to disable the automatic execution poller (useful for tests/manual operation).
DEVCOCKPIT_EXECUTION_POLL_SECONDS=30

# Maximum number of simultaneously active DEV WorkItems.
DEVCOCKPIT_MAX_PARALLEL_DEV_EXECUTIONS=2

# ResourceLock lease duration; the poller renews live locks before expiry.
DEVCOCKPIT_RESOURCE_LOCK_LEASE_SECONDS=900

# Docker Compose overrides DATABASE_URL to /data/devcockpit.db and
# PROJECTS_CONFIG_PATH to /app/projects.json.

# DEV watchdog: prepare one same-session follow-up when an ACKed DEV prompt
# still has no PR and its associated branch has not advanced for this long.
DEVCOCKPIT_DEV_STALE_AFTER_SECONDS=3600

# DC-072 GitHub wait watchdogs. These are independent from the stale-DEV timer.
# Open PR with no pull_request workflow observed on the current head.
DEVCOCKPIT_PR_NO_CI_AFTER_SECONDS=900
# Current-head workflow queued/running without GitHub progress.
DEVCOCKPIT_CI_STALL_AFTER_SECONDS=1800
# Grace given to an armed auto-merge before deterministic DC-071 fallback.
DEVCOCKPIT_AUTO_MERGE_GRACE_SECONDS=600
