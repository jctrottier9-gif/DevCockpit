DEVCOCKPIT_APP_NAME=DevCockpit
DEVCOCKPIT_ENVIRONMENT=development
DEVCOCKPIT_DATABASE_URL=sqlite+pysqlite:///./devcockpit.db
DEVCOCKPIT_PROJECTS_CONFIG_PATH=projects.json
# Optional for private repositories or higher GitHub API limits. Never expose this to React/Firefox.
# DEVCOCKPIT_GITHUB_TOKEN=github_pat_...
DEVCOCKPIT_GITHUB_TIMEOUT_SECONDS=5
